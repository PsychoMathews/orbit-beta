# Copie este arquivo para .env e preencha. NUNCA compartilhe o .env.
# No programa instalado, o guia de primeira configuração cria este arquivo sozinho em %APPDATA%\Orbit Beta\dados.

# Cérebro na nuvem (API do Claude, paga por uso). Sem chave = tudo no Ollama local.
ANTHROPIC_API_KEY=
CLOUD_MODEL=claude-sonnet-5-5
CLOUD_EFFORT=low
CLOUD_CHANNELS=pc

# Ollama (IA local; precisa de placa de vídeo com 8 GB ou mais)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Modelo grande (opcional), usado quando você começa a mensagem com /pesado
OLLAMA_MODEL_HEAVY=

# Telegram (opcional): token do @BotFather e o seu ID numérico (mande /start pro bot que ele te mostra).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Voz: "elevenlabs" (melhor, gasta créditos; cai para a voz da Microsoft se falhar) ou "local". Ouvido: "local" (grátis).
VOICE_ENGINE=local
STT_ENGINE=local
EDGE_VOICE=pt-BR-FranciscaNeural
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# ElevenLabs (opcional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_SPEED=1.0
ELEVENLABS_STABILITY=0.6
# Voz offline (Kokoro): precisa dos arquivos em models/. pf_dora (feminina), pm_alex e pm_santa (masculinas)
KOKORO_VOICE=pf_dora
KOKORO_SPEED=1.0

# Pastas que a assistente NUNCA apaga (separe por ;). Windows e Arquivos de Programas já são sempre protegidos.
PROTECTED_PATHS=%USERPROFILE%\Pictures;%USERPROFILE%\Videos;%USERPROFILE%\Documents;%USERPROFILE%\Music;%USERPROFILE%\Desktop;%USERPROFILE%\OneDrive

# Atalho para falar pelo microfone do PC
HOTKEY=ctrl+alt+space
# Microfone do atalho (parte do nome); vazio = padrão do Windows
MIC_DEVICE=

# Alexa (fora da beta): ID da sua skill e endereço público do túnel
ALEXA_SKILL_ID=
ALEXA_PORT=8787
ALEXA_PUBLIC_URL=
# Atalho do iPhone: chave longa e aleatória (o atalho manda no cabeçalho Authorization: Bearer ...)
SHORTCUT_TOKEN=

# Proatividade: resumo da manhã (HH:MM; vazio desliga), aviso de reunião, silêncio para avisos automáticos
MORNING_TIME=
MEETING_ALERT_MIN=10
QUIET_START=23
QUIET_END=7
# Falar os avisos também nas caixas de som do PC
PC_SPEAK=1
# Cidade padrão para o clima
HOME_CITY=São Paulo

# Modo trabalho: programas para abrir e processos para fechar (separados por ;)
WORK_APPS=
WORK_CLOSE=

# Projetos de vídeo (DaVinci, opcional): onde criar, estrutura de pastas (separe por ;) e destino de backup
VIDEO_PROJECTS_DIR=
PROJECT_TEMPLATE=1.BRUTOS;2.AUDIO;3.ASSETS;4.PROJETO;5.RENDER
BACKUP_DIR=
